{
  "name": "openmind-harness-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OpenMind Harness desktop shell for Windows, macOS and Linux",
  "main": "main.cjs",
  "scripts": {
    "start": "node make-icon.cjs && electron .",
    "dist": "node make-icon.cjs && electron-builder --publish never",
    "dist:win": "node make-icon.cjs && electron-builder --win nsis portable --publish never",
    "dist:mac": "node make-icon.cjs && electron-builder --mac dmg zip --publish never",
    "dist:linux": "node make-icon.cjs && electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "sharp": "0.34.5"
  },
  "build": {
    "appId": "app.openmind.harness.desktop",
    "productName": "OpenMind Harness",
    "directories": {
      "output": "../dist/desktop"
    },
    "files": [
      "main.cjs",
      "package.json",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../dashboard",
        "to": "omh-runtime/dashboard"
      },
      {
        "from": "../scripts",
        "to": "omh-runtime/scripts"
      },
      {
        "from": "../modules",
        "to": "omh-runtime/modules"
      },
      {
        "from": "../lib",
        "to": "omh-runtime/lib"
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "artifactName": "OMH-Desktop-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "icon": "icon.png"
  },
  "homepage": "https://github.com/tjcrims0nx/openmind-harness",
  "author": {
    "name": "Cerberus AI",
    "email": "tjcrims0n420@gmail.com"
  }
}
