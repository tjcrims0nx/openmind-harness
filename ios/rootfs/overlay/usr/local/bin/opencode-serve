#!/bin/sh
# Launch the OpenCode web UI inside the OpenMind Harness iOS app's Linux guest.
#
# The iOS app runs this as the supervised foreground process and points its
# WKWebView at http://127.0.0.1:$DSH_PORT once the server answers.
#
#   DSH_PORT            listen port (default 3080; set by the iOS app)
#   OPENCODE_WORKSPACE  initial working directory (default /root/workspace)
#   EXPLABS_API_KEY     API key for the default Experiential Labs provider.
#                       Leave unset and the OpenCode web UI prompts for a key
#                       when the model is first used.
#
# The server is deliberately unsecured: it binds 127.0.0.1 inside the guest,
# reachable only from this device and this app — the same loopback-only model
# as the DSH build. Do NOT set OPENCODE_SERVER_PASSWORD here; it would put a
# login screen in front of the app's web view.
export HOME=/root
export OPENCODE_WORKSPACE="${OPENCODE_WORKSPACE:-/root/workspace}"
PORT="${DSH_PORT:-3080}"

mkdir -p "$OPENCODE_WORKSPACE"
cd "$OPENCODE_WORKSPACE"

# Saved environment (~/.config/opencode/.env): the place for a custom
# endpoint URL + bearer key (openmind-set-custom-endpoint) and any other
# provider keys the user saved there. Sourced before the server starts
# so the Custom endpoint provider works in the app. The file is mode
# 0600 and its values are never printed.
if [ -f "$HOME/.config/opencode/.env" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.config/opencode/.env"
fi

# Antigravity bridge (loopback translator for the Antigravity provider).
# Runs only when node and the bridge are present; it serves /v1/models
# regardless, and chat calls fail cleanly until the user signs in with
# `openmind-antigravity-login`. Loopback-only, same model as this server.
if command -v node >/dev/null 2>&1 && [ -f /usr/local/bin/openmind-antigravity-bridge.mjs ]; then
  (node /usr/local/bin/openmind-antigravity-bridge.mjs >> /root/antigravity-bridge.log 2>&1 &) || true
fi

exec /usr/local/bin/opencode serve --hostname 127.0.0.1 --port "$PORT" "$@"
