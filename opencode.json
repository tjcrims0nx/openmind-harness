{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5",
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    },
    "experientiallabs": {
      "models": {
        "deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash (free)"
        }
      },
      "name": "Experiential Labs",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:EXPLABS_API_KEY}",
        "baseURL": "https://api.experientiallabs.ai/v1"
      }
    },
    "google": {
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    },
    "groq": {
      "options": {
        "apiKey": "{env:GROQ_API_KEY}"
      }
    },
    "lmstudio": {},
    "mistral": {
      "options": {
        "apiKey": "{env:MISTRAL_API_KEY}"
      }
    },
    "ollama": {},
    "openai": {},
    "openrouter": {
      "models": {
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free": {
          "name": "Nemotron 3 Nano Omni 30B Reasoning (free)"
        }
      },
      "name": "OpenRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1"
      }
    },
    "orcarouter": {
      "models": {
        "tencent/hy3-free": {
          "name": "Tencent HY3 (free)"
        },
        "tencent/hy4-preview-free": {
          "name": "Tencent HY4 Preview (free)"
        },
        "z-ai/glm-5.3-flash-free": {
          "name": "GLM 5.3 Flash (free)"
        }
      },
      "name": "OrcaRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:ORCAROUTER_API_KEY}",
        "baseURL": "https://api.orcarouter.ai/v1"
      }
    },
    "together": {
      "options": {
        "apiKey": "{env:TOGETHER_API_KEY}"
      }
    },
    "xai": {
      "options": {
        "apiKey": "{env:XAI_API_KEY}"
      }
    },
    "custom": {
      "name": "Custom Endpoint",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:OPENMIND_CUSTOM_API_KEY}",
        "baseURL": "{env:OPENMIND_CUSTOM_BASE_URL}"
      }
    }
  },
  "experimental": {
    "home_memory": true
  },
  "agents": {
    "fast": {
      "description": "Fast, free model for small jobs — quick questions, small edits, summaries. Use when the work is small and speed matters more than maximum capability.",
      "mode": "primary",
      "model": "experientiallabs/deepseek-v4.1-flash:free",
      "system": "You are a fast coding assistant. Keep answers short and do only the small task asked."
    },
    "reviewer": {
      "description": "Reviews current changes for correctness and regressions. Read-only.",
      "mode": "subagent",
      "model": "openai/gpt-5",
      "permission": {
        "bash": "deny",
        "edit": "deny"
      },
      "system": "Review only. Do not modify files. List findings in severity order with file and line references."
    }
  }
}