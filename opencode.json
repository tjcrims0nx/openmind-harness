{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.5-flash-lite",
  "small_model": "experientiallabs/deepseek-v4.1-flash:free",
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    },
    "experientiallabs": {
      "models": {
        "deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash (free)"
        }
      },
      "name": "Experiential Labs",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:EXPLABS_API_KEY}",
        "baseURL": "https://api.experientiallabs.ai/v1"
      }
    },
    "google": {
      "models": {
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash"
        },
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite"
        }
      },
      "options": {
        "apiKey": "{env:GEMINI_API_KEY}"
      }
    },
    "groq": {
      "options": {
        "apiKey": "{env:GROQ_API_KEY}"
      }
    },
    "lmstudio": {},
    "mistral": {
      "options": {
        "apiKey": "{env:MISTRAL_API_KEY}"
      }
    },
    "ollama": {},
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    },
    "openrouter": {
      "models": {
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free": {
          "name": "Nemotron 3 Nano Omni 30B Reasoning (free)"
        }
      },
      "name": "OpenRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1"
      }
    },
    "orcarouter": {
      "models": {
        "tencent/hy3-free": {
          "name": "Tencent HY3 (free)"
        },
        "tencent/hy4-preview-free": {
          "name": "Tencent HY4 Preview (free)"
        },
        "z-ai/glm-5.3-flash-free": {
          "name": "GLM 5.3 Flash (free)"
        }
      },
      "name": "OrcaRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:ORCAROUTER_API_KEY}",
        "baseURL": "https://api.orcarouter.ai/v1"
      }
    },
    "antigravity": {
      "models": {
        "gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)"
        }
      },
      "name": "Antigravity",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:ANTIGRAVITY_API_KEY}",
        "baseURL": "http://127.0.0.1:18080/v1"
      }
    },
    "apinex": {
      "models": {
        "free/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (free)"
        },
        "free/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (free)"
        },
        "free/gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash (free)"
        },
        "free/gpt-6-luna": {
          "name": "GPT-6 Luna (free)"
        },
        "free/claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6 (free)"
        }
      },
      "name": "APInex",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:APINEX_API_KEY}",
        "baseURL": "https://api.apinex.bond/v1"
      }
    },
    "pollinations": {
      "models": {
        "gpt-oss-20b": {
          "name": "GPT-OSS 20B (free, no key)"
        }
      },
      "name": "Pollinations",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "pollinations",
        "baseURL": "https://text.pollinations.ai/openai"
      }
    },
    "github-models": {
      "models": {
        "openai/gpt-4.1": {
          "name": "GPT-4.1 (GitHub Models, free)"
        },
        "deepseek/DeepSeek-R1": {
          "name": "DeepSeek R1 (GitHub Models, free)"
        },
        "meta/Meta-Llama-3.3-70B-Instruct": {
          "name": "Llama 3.3 70B (GitHub Models, free)"
        }
      },
      "name": "GitHub Models",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:GITHUB_TOKEN}",
        "baseURL": "https://models.github.ai/inference"
      }
    },
    "together": {
      "options": {
        "apiKey": "{env:TOGETHER_API_KEY}"
      }
    },
    "xai": {
      "options": {
        "apiKey": "{env:XAI_API_KEY}"
      }
    },
    "custom": {
      "name": "Custom Endpoint",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:OPENMIND_CUSTOM_API_KEY}",
        "baseURL": "{env:OPENMIND_CUSTOM_BASE_URL}"
      },
      "models": {}
    },
    "zai": {
      "name": "GLM (Z.AI)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:ZAI_API_KEY}",
        "baseURL": "https://api.z.ai/api/paas/v4"
      },
      "models": {
        "glm-4.5": {
          "name": "GLM 4.5"
        }
      }
    },
    "moonshotai": {
      "name": "Kimi (Moonshot AI)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:MOONSHOT_API_KEY}",
        "baseURL": "https://api.moonshot.ai/v1"
      },
      "models": {
        "kimi-k2.5": {
          "name": "Kimi K2.5"
        }
      }
    },
    "qwen": {
      "name": "Qwen (Alibaba Cloud)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:DASHSCOPE_API_KEY}",
        "baseURL": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
      },
      "models": {
        "qwen-plus": {
          "name": "Qwen Plus"
        }
      }
    }
  },
  "experimental": {
    "home_memory": true
  },
  "agent": {
    "fast": {
      "description": "Fast, free model for small jobs — quick questions, small edits, summaries. Use when the work is small and speed matters more than maximum capability.",
      "mode": "primary",
      "model": "experientiallabs/deepseek-v4.1-flash:free",
      "prompt": "You are a fast coding assistant. Keep answers short and do only the small task asked."
    },
    "reviewer": {
      "description": "Reviews current changes for correctness and regressions. Read-only.",
      "mode": "all",
      "model": "google/gemini-3.5-flash-lite",
      "permission": {
        "bash": "deny",
        "edit": "deny"
      },
      "prompt": "Review only. Do not modify files. List findings in severity order with file and line references."
    },
    "planner": {
      "description": "Read-only architecture planner. Delegated by an OMH user or coordinating agent.",
      "mode": "all",
      "model": "google/gemini-3.5-flash-lite",
      "permission": {
        "bash": "deny",
        "edit": "deny"
      },
      "prompt": "Produce a scoped implementation plan with acceptance criteria. Do not modify files or execute commands."
    },
    "implementer": {
      "description": "Scoped code implementer; filesystem/tool permissions remain enforced by OpenCode.",
      "mode": "all",
      "model": "google/gemini-3.5-flash-lite",
      "prompt": "Implement only the explicitly assigned change. Prefer minimal patches and include exact files changed. Do not claim testing without running tests."
    },
    "tester": {
      "description": "Read-only test analyst; does not execute shell or modify source.",
      "mode": "all",
      "model": "google/gemini-3.5-flash-lite",
      "permission": {
        "bash": "deny",
        "edit": "deny"
      },
      "prompt": "Review test coverage, propose reproducible test commands, and highlight failures without editing or executing commands."
    }
  }
}
