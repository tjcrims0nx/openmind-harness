    "zustand": "^4.5.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "@types/node": "^22.15.0"
  }
